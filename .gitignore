# build output
dist/
# generated types
.astro/

# heading font, built by scripts/subset-heading-font.mjs
src/styles/generated/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.dev.vars
.dev.vars.*

# A local checkout of private notes at the repo root. Never part of this public site.
/private-notes/
deploy/private-notes/notes/*
!deploy/private-notes/notes/README.md

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Obsidian workspace (device-specific, not shareable)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Claude Code local/personal files (keep project context, ignore personal notes)
.claude/*.local.md
