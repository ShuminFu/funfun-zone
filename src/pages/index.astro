---
/**
 * Homepage
 *
 * Landing page with:
 * - Hero section
 * - Recent posts
 * - Featured projects (if enabled)
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import GrowthIndicator from '../components/GrowthIndicator.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import { siteConfig } from '../config';
import Logo from '../components/Logo.astro';
import { calculateAllGrowth, getEffectiveGrowth, participatesInGrowth } from '../utils/growth';
import type { GrowthStatus } from '../types';

// Get all posts, filter drafts in production
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Stage counts for the hero, using the same effective growth as the garden page.
const growthResults = calculateAllGrowth(allPosts);
const growthOf = (post: (typeof allPosts)[number]): GrowthStatus => {
  const result = growthResults.get(post.id);
  return result ? getEffectiveGrowth(result, siteConfig.garden.autoGrowth) : post.data.growth;
};
const stageCounts = (['seedling', 'budding', 'evergreen'] as const)
  .map((status) => ({
    status,
    count: allPosts.filter((p) => participatesInGrowth(p.data.tags) && growthOf(p) === status).length,
  }))
  .filter((stage) => stage.count > 0);

// Sort by planted date, newest first
const recentPosts = allPosts
  .sort((a, b) => b.data.planted.valueOf() - a.data.planted.valueOf())
  .slice(0, 6);

// Featured projects, when the folder actually has notes.
const projectDir = path.join(process.cwd(), 'src/content/projects');
const hasProjects = fs.existsSync(projectDir)
  && fs.readdirSync(projectDir).some((name) => name.endsWith('.md') || name.endsWith('.mdx'));
const allProjects = hasProjects ? await getCollection('projects') : [];
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<BaseLayout>
  <Header slot="header" />

  <div class="max-w-5xl mx-auto px-4 py-8 sm:py-16">
    <!-- Hero. Left-aligned so the title shares an edge with the notes below. -->
    <section class="relative mb-16 sm:mb-20">
      <Logo class="pointer-events-none absolute -top-2 right-2 hidden h-44 w-24 text-primary-200 sm:block dark:text-primary-800" />

      <h1 class="mb-4 text-5xl tracking-tight text-primary-900 dark:text-primary-100 sm:text-6xl">
        {siteConfig.name}
      </h1>

      <p class="mb-5 max-w-xl text-lg text-primary-600 dark:text-primary-400">
        {siteConfig.description}
      </p>

      <!-- Live counts; each stage opens the garden filtered to it. -->
      <p class="mb-8 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm tabular-nums text-primary-600 dark:text-primary-400">
        <a href="/posts/" class="transition-colors hover:text-primary-900 dark:hover:text-primary-100">
          {allPosts.length} notes in the garden
        </a>
        {stageCounts.map(({ status, count }) => (
          <a
            href={`/posts/?growth=${status}`}
            class="inline-flex items-center gap-1.5 transition-colors hover:text-primary-900 dark:hover:text-primary-100"
          >
            <GrowthIndicator status={status} size="sm" />
            {count} {status}
          </a>
        ))}
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/posts/"
          class="inline-flex items-center rounded-xl bg-primary-900 px-5 py-2.5 font-sans font-medium text-primary-50 transition-colors hover:bg-primary-700 dark:bg-primary-100 dark:text-primary-950 dark:hover:bg-white"
        >
          Explore the Garden
          <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href="/about/"
          class="inline-flex items-center rounded-xl border border-primary-300 px-5 py-2.5 font-sans font-medium text-primary-800 transition-colors hover:border-primary-500 hover:bg-white dark:border-primary-700 dark:text-primary-200 dark:hover:border-primary-500 dark:hover:bg-primary-900"
        >
          About
        </a>
      </div>
    </section>

    <!-- Recent Posts -->
    {recentPosts.length > 0 && (
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl text-primary-900 dark:text-primary-100">
            Recent Notes
          </h2>
          <a
            href="/posts/"
            class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300"
          >
            View all &rarr;
          </a>
        </div>

        <!-- Grid items stay height:auto. h-full on the item would size each card to its content. -->
        <div class="grid grid-cols-1 gap-8 md:grid-flow-dense md:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <div class:list={["flex min-w-0 flex-col", post.data.icon && "md:col-span-2"]}>
              <PostCard post={post} effectiveGrowth={growthOf(post)} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <section class="mt-16">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-2xl text-primary-900 dark:text-primary-100">
            Featured Projects
          </h2>
          <a
            href="/projects/"
            class="text-sm font-medium text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300"
          >
            View all &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredProjects.map((project) => (
            <a
              href={`/projects/${project.id}/`}
              class="block p-6 rounded-xl border border-primary-200 dark:border-primary-800 hover:border-accent-300 dark:hover:border-accent-700 transition-colors"
            >
              <h3 class="text-lg font-semibold text-primary-900 dark:text-primary-100 mb-2">
                {project.data.title}
              </h3>
              <p class="text-sm text-primary-600 dark:text-primary-400 mb-3">
                {project.data.description}
              </p>
              {project.data.technologies && (
                <div class="flex flex-wrap gap-1">
                  {project.data.technologies.slice(0, 3).map((tech: string) => (
                    <span class="text-xs px-2 py-1 rounded-sm bg-primary-100 dark:bg-primary-800 text-primary-600 dark:text-primary-400">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Growth Legend -->
    <section class="mt-20 border-t border-primary-200 pt-10 dark:border-primary-800">
      <h3 class="mb-6 text-lg text-primary-900 dark:text-primary-100">
        How to Read This Garden
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
        <div class="flex items-start gap-3">
          <GrowthIndicator status="seedling" />
          <div>
            <span class="font-medium text-primary-900 dark:text-primary-100">Seedling</span>
            <p class="text-primary-600 dark:text-primary-400">New ideas, rough drafts</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <GrowthIndicator status="budding" />
          <div>
            <span class="font-medium text-primary-900 dark:text-primary-100">Budding</span>
            <p class="text-primary-600 dark:text-primary-400">Growing, needs work</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <GrowthIndicator status="evergreen" />
          <div>
            <span class="font-medium text-primary-900 dark:text-primary-100">Evergreen</span>
            <p class="text-primary-600 dark:text-primary-400">Mature, well-maintained</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
