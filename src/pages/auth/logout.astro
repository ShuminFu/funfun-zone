---
/**
 * Static fallback for local preview. The deployed site redirects this path
 * to Cloudflare Access logout.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Sign out" description="Sign-out is completed by Cloudflare Access on the deployed site." noIndex>
  <Header slot="header" />

  <div class="relative mx-auto max-w-5xl px-4 py-20 sm:py-28">
    <p class="mb-3 font-mono text-sm text-primary-600 dark:text-primary-400">Sign out</p>
    <h1 class="mb-4 text-4xl tracking-tight text-primary-900 dark:text-primary-100 sm:text-5xl">
      Sign-out runs on the deployed site
    </h1>
    <p class="mb-8 max-w-xl text-lg text-primary-600 dark:text-primary-400">
      This preview does not hold a session. The deployed site ends it with Cloudflare Access.
    </p>
    <a
      href="/"
      class="inline-flex items-center rounded-xl border border-primary-300 px-5 py-2.5 font-sans font-medium text-primary-800 transition-colors hover:border-primary-500 hover:bg-white dark:border-primary-700 dark:text-primary-200 dark:hover:border-primary-500 dark:hover:bg-primary-900"
    >
      Home
    </a>
  </div>

  <Footer slot="footer" />
</BaseLayout>
