---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return pages.map(page => ({
    params: { slug: page.id },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Header slot="header" />
  <div class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <article>
      <header class="mb-8">
        <h1 class="text-4xl leading-tight text-primary-900 dark:text-primary-100">
          {page.data.title}
        </h1>
        {page.data.description && (
          <p class="mt-4 text-lg text-primary-600 dark:text-primary-400">
            {page.data.description}
          </p>
        )}
      </header>

      <div class="prose-mycelium">
        <Content />
      </div>
    </article>
  </div>
  <Footer slot="footer" />
</BaseLayout>
