---
/**
 * Tags Component
 *
 * Display a list of tags with links to tag pages
 */

export interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<div class="flex max-w-full flex-wrap gap-2">
  {tags.map((tag) => (
    linked ? (
      <a
        href={`/posts/tag/${tag}/`}
        class="inline-flex max-w-full items-center wrap-break-word rounded-full bg-primary-100 px-2.5 py-0.5 text-xs text-primary-600 dark:bg-primary-800 dark:text-primary-300 transition-colors hover:bg-accent-100 hover:text-accent-700 dark:hover:bg-accent-900 dark:hover:text-accent-200"
      >
        #{tag}
      </a>
    ) : (
      <span class="inline-flex max-w-full items-center wrap-break-word rounded-full bg-primary-100 px-2.5 py-0.5 text-xs text-primary-600 dark:bg-primary-800 dark:text-primary-300">
        #{tag}
      </span>
    )
  ))}
</div>
