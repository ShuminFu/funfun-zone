---
/**
 * Tags Component
 *
 * Display a list of tags with links to tag pages
 */

export interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<div class="flex max-w-full flex-wrap gap-2">
  {tags.map((tag) => (
    linked ? (
      <a
        href={`/posts/tag/${tag}/`}
        class="inline-flex max-w-full items-center wrap-break-word rounded-full border border-primary-200 px-2.5 py-0.5 text-xs text-primary-600 transition-colors hover:border-primary-400 hover:text-primary-900 dark:border-primary-700 dark:text-primary-300 dark:hover:border-primary-500 dark:hover:text-primary-100"
      >
        #{tag}
      </a>
    ) : (
      <span class="inline-flex max-w-full items-center wrap-break-word rounded-full border border-primary-200 px-2.5 py-0.5 text-xs text-primary-600 dark:border-primary-700 dark:text-primary-300">
        #{tag}
      </span>
    )
  ))}
</div>
