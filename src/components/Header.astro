---
/**
 * Header Component
 *
 * Site navigation with:
 * - Site title/logo
 * - Navigation links
 * - Theme toggle
 * - Mobile menu
 */

import { siteConfig } from '../config';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import ThemeSelector from './ThemeSelector.astro';

const currentPath = Astro.url.pathname;

function isActive(url: string): boolean {
  if (url === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(url);
}
---

<header class="sticky top-0 z-40 w-full border-b border-primary-200 bg-primary-50/90 backdrop-blur-xs dark:border-primary-800 dark:bg-primary-950/90">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
    <!-- Logo / Site Name. Sans on purpose: chrome is not a title. -->
    <a
      href="/"
      aria-label={siteConfig.name}
      class="flex items-center gap-2 font-sans text-lg font-medium text-primary-900 dark:text-primary-100"
    >
      <Logo class="w-6 h-6" />
      <span class="hidden sm:inline">{siteConfig.name}</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      {siteConfig.navigation.items.map((item) => (
        <a
          href={item.url}
          class:list={[
            'font-sans text-sm transition-colors',
            isActive(item.url)
              ? 'text-primary-900 dark:text-primary-100'
              : 'text-primary-500 hover:text-primary-900 dark:text-primary-400 dark:hover:text-primary-100',
          ]}
        >
          {item.title}
        </a>
      ))}

      <div class="h-4 w-px bg-primary-200 dark:bg-primary-700" />

      <ThemeSelector />
      <ThemeToggle />
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      class="md:hidden p-2 text-primary-600 dark:text-primary-400 hover:text-primary-900 dark:hover:text-primary-100"
      aria-label="Toggle menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-primary-200 dark:border-primary-800 bg-primary-50 dark:bg-primary-950"
  >
    <div class="px-4 py-4 space-y-2">
      {siteConfig.navigation.items.map((item) => (
        <a
          href={item.url}
          class:list={[
            'block py-2 px-3 rounded-lg text-sm font-medium transition-colors',
            isActive(item.url)
              ? 'text-primary-900 dark:text-primary-100'
              : 'text-primary-600 hover:text-primary-900 dark:text-primary-400 dark:hover:text-primary-100',
          ]}
        >
          {item.title}
        </a>
      ))}

      <div class="pt-2 border-t border-primary-200 dark:border-primary-800">
        <div class="flex items-center justify-between py-2 px-3">
          <span class="text-sm text-primary-600 dark:text-primary-400">Theme</span>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');

    if (button && menu) {
      button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!button.contains(e.target as Node) && !menu.contains(e.target as Node)) {
          menu.classList.add('hidden');
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initMobileMenu);
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
