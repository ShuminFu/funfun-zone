---
/**
 * GrowthIndicator Component
 *
 * Visual indicator for digital garden note growth status:
 * - Seedling: New idea, rough draft
 * - Budding: Developing, needs work
 * - Evergreen: Mature, well-maintained
 */

import type { GrowthStatus } from '../types';

export interface Props {
  status: GrowthStatus;
  showLabel?: boolean;
  size?: 'sm' | 'md' | 'lg';
  /** Filter tabs inherit the button color so a stage tint does not vanish on the active tab. */
  tint?: boolean;
}

const { status, showLabel = false, size = 'md', tint = true } = Astro.props;

const sizeClasses = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const labels = {
  seedling: 'Seedling',
  budding: 'Budding',
  evergreen: 'Evergreen',
};

const descriptions = {
  seedling: 'A new idea, freshly planted',
  budding: 'Growing and developing',
  evergreen: 'Mature and well-tended',
};

const iconClass = sizeClasses[size];
---

<span
  class:list={[
    'inline-flex items-center gap-1.5',
    tint && `growth-${status}`,
  ]}
  title={descriptions[status]}
>
  {status === 'seedling' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class={iconClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3.2 21.6h17.6"/>
      <path d="M12 21.6V13.1"/>
      <ellipse cx="7.45" cy="12.15" rx="5.05" ry="2.55" fill="currentColor" stroke="none" transform="rotate(30 7.45 12.15)"/>
      <ellipse cx="16.55" cy="12.15" rx="5.05" ry="2.55" fill="currentColor" stroke="none" transform="rotate(-30 16.55 12.15)"/>
    </svg>
  )}

  {status === 'budding' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class={iconClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3.2 21.6h17.6"/>
      <path d="M12 21.6V11"/>
      <ellipse cx="7.35" cy="16.15" rx="4.7" ry="2.2" fill="currentColor" stroke="none" transform="rotate(28 7.35 16.15)"/>
      <ellipse cx="16.65" cy="16.15" rx="4.7" ry="2.2" fill="currentColor" stroke="none" transform="rotate(-28 16.65 16.15)"/>
      <path fill="currentColor" stroke="none" d="M12 1.05c1.15 2.35 3.15 4.85 3.15 7.15 0 1.85-1.4 3.3-3.15 3.3s-3.15-1.45-3.15-3.3c0-2.3 2-4.8 3.15-7.15z"/>
    </svg>
  )}

  {status === 'evergreen' && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class={iconClass}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path fill="currentColor" stroke="none" d="M12 .85 16.3 5.7 13.1 6.6 18.7 10.8 14.7 11.7 21.1 16.2 16.1 17.1 22.5 21.2 14.15 21.2 14.15 22.35 9.85 22.35 9.85 21.2 1.5 21.2 7.9 17.1 2.9 16.2 9.3 11.7 5.3 10.8 10.9 6.6 7.7 5.7Z"/>
      <path d="M3.2 22.55h17.6"/>
    </svg>
  )}

  {showLabel && (
    <span class="text-sm font-medium">{labels[status]}</span>
  )}
</span>
