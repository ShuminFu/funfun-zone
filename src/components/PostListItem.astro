---
/**
 * PostListItem Component
 *
 * Blog-style list item for post previews with:
 * - Title
 * - Description
 * - Growth status
 * - Dates
 * - Tags
 * - Reading time
 */

import type { Post, GrowthStatus } from '../types';
import GrowthIndicator from './GrowthIndicator.astro';
import MemoryPoint from './MemoryPoint.astro';
import Tags from './Tags.astro';
import { siteConfig } from '../config';
import { participatesInGrowth } from '../utils/growth';

export interface Props {
  post: Post;
  effectiveGrowth?: GrowthStatus; // Calculated growth (may differ from post.data.growth)
}

const { post, effectiveGrowth } = Astro.props;
const { title, description, growth, planted, tags, icon, iconAlt } = post.data;
// Use effective growth if provided, otherwise fall back to manual growth
const displayGrowth = effectiveGrowth || growth;
const showGrowth = siteConfig.garden.showGrowthStatus && participatesInGrowth(tags);

const plantedDate = planted.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: siteConfig.timezone,
});

// Estimate reading time (rough: 200 words per minute)
const content = post.body || '';
const wordCount = content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<article class="group min-w-0 border-b border-primary-200 py-8 last:border-b-0 dark:border-primary-800">
  <a href={`/posts/${post.id}/`} class:list={["block", icon && "flex items-start gap-5"]}>
    <div class:list={[icon ? "min-w-0 grow" : "contents"]}>
    <!-- Meta line: date, growth, reading time -->
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-primary-600 dark:text-primary-400">
      <time class="tabular-nums">{plantedDate}</time>
      {showGrowth && (
        <>
          <span class="text-primary-300 dark:text-primary-700">·</span>
          <GrowthIndicator status={displayGrowth} size="sm" showLabel={true} />
        </>
      )}
      {siteConfig.posts.showReadingTime && (
        <>
          <span class="text-primary-300 dark:text-primary-700">·</span>
          <span>{readingTime} min read</span>
        </>
      )}
    </div>

    <!-- Title -->
    <h2 class="mb-3 text-2xl leading-snug text-primary-900 transition-colors group-hover:text-accent-700 dark:text-primary-100 dark:group-hover:text-accent-300">
      {title}
    </h2>

    <!-- Description -->
    {description && (
      <p class="text-primary-600 dark:text-primary-400 leading-relaxed mb-4">
        {description}
      </p>
    )}
    </div>
    {icon && (
      <MemoryPoint src={icon} alt={iconAlt ?? ''} variant="list" />
    )}
  </a>

  <!-- Tags -->
  {siteConfig.posts.showTags && tags && tags.length > 0 && (
    <Tags tags={tags} />
  )}
</article>
