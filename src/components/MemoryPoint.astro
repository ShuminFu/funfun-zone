---
/**
 * Same small illustration on the garden card and above the article title.
 * Absent icon: callers render nothing, so text-only posts stay as they are.
 */
interface Props {
  src: string;
  alt?: string;
  variant: 'card' | 'article' | 'list';
}

const { src, alt = '', variant } = Astro.props;
---

{variant === 'card' && (
  <span class="flex h-full w-full items-center justify-center border-l border-primary-200 px-4 py-6 dark:border-primary-800">
    <img src={src} alt={alt} class="max-h-36 w-full object-contain dark:brightness-0 dark:invert" />
  </span>
)}

{variant === 'article' && (
  <div class="mb-6 flex justify-center">
    <div class="flex h-24 w-24 items-center justify-center rounded-xl border border-primary-200 bg-primary-50 p-3.5 dark:border-primary-800 dark:bg-primary-900 sm:h-28 sm:w-28">
      <img src={src} alt={alt} class="h-full w-full object-contain dark:brightness-0 dark:invert" />
    </div>
  </div>
)}

{variant === 'list' && (
  <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl border border-primary-200 bg-primary-50 p-3 dark:border-primary-800 dark:bg-primary-900">
    <img src={src} alt={alt} class="h-full w-full object-contain dark:brightness-0 dark:invert" />
  </span>
)}
