---
/**
 * LocalGraph Component
 *
 * "Connections" panel in the article sidebar: a collapsed row that opens to
 * the linked notes as a list, plus a small D3 force graph of
 * - the current post as center node
 * - connected posts as surrounding nodes
 * - links between them
 * d3 is loaded the first time the panel is opened. The open state is
 * remembered across notes in localStorage.
 */

import type { Post } from '../types';
import { getCollection } from 'astro:content';
import { extractAllLinks } from '../utils/backlinks';
import { siteConfig } from '../config';

export interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Get all posts for graph data
const allPosts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Build graph data
interface GraphNode {
  id: string;
  title: string;
  connections: number;
}

interface GraphConnection {
  source: string;
  target: string;
}

const nodes: GraphNode[] = [];
const connections: GraphConnection[] = [];
const nodeMap = new Map<string, GraphNode>();

// Create nodes for all posts
for (const post of allPosts) {
  const node: GraphNode = {
    id: post.id,
    title: post.data.title,
    connections: 0,
  };
  nodes.push(node);
  nodeMap.set(post.id, node);
}

// Create connections based on links
for (const post of allPosts) {
  const body = post.body || '';
  const links = extractAllLinks(body);

  for (const link of links) {
    // Find target post by slug
    const targetPost = allPosts.find((p) => p.id === link.slug);
    if (targetPost && targetPost.id !== post.id) {
      // Check if connection already exists
      const exists = connections.some(
        (c) =>
          (c.source === post.id && c.target === targetPost.id) ||
          (c.source === targetPost.id && c.target === post.id)
      );

      if (!exists) {
        connections.push({
          source: post.id,
          target: targetPost.id,
        });

        // Increment connection counts
        const sourceNode = nodeMap.get(post.id);
        const targetNode = nodeMap.get(targetPost.id);
        if (sourceNode) sourceNode.connections++;
        if (targetNode) targetNode.connections++;
      }
    }
  }
}

// Filter to only show nodes connected to current post (for local graph)
let filteredNodes = nodes;
let filteredConnections = connections;

if (currentSlug) {
  const connectedIds = new Set([currentSlug]);

  // Find directly connected nodes
  for (const conn of connections) {
    if (conn.source === currentSlug) {
      connectedIds.add(conn.target);
    } else if (conn.target === currentSlug) {
      connectedIds.add(conn.source);
    }
  }

  filteredNodes = nodes.filter((n) => connectedIds.has(n.id));
  filteredConnections = connections.filter(
    (c) => connectedIds.has(c.source) && connectedIds.has(c.target)
  );
}

// Check if there are any connections to show
const hasConnections = filteredNodes.length > 1;
const connectedNotes = filteredNodes.filter((n) => n.id !== currentSlug);

const graphData = JSON.stringify({
  nodes: filteredNodes,
  connections: filteredConnections,
  currentSlug,
});

// Markup notes (Astro 7 does not allow HTML comments inside an expression):
// the panel is collapsed by default, one row with the count. Opening it shows
// the linked notes as a list and draws the graph. The id on <details> is what
// PostLayout's :has() selectors look for to show the sidebar.
---

{hasConnections && siteConfig.features.localGraph && (
  <details
    id="local-graph-container"
    class="connections group/conn rounded-xl border border-primary-200 bg-white dark:border-primary-800 dark:bg-primary-900"
    data-graph={graphData}
  >
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-xl px-3.5 py-2.5 font-sans text-sm font-medium text-primary-700 transition-colors hover:text-primary-900 dark:text-primary-300 dark:hover:text-primary-100 [&::-webkit-details-marker]:hidden"
    >
      <span class="inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-500 dark:text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="6" cy="6" r="2.5"/>
          <circle cx="18" cy="9" r="2.5"/>
          <circle cx="9" cy="18" r="2.5"/>
          <path d="M8.3 7 15.7 8.4M7 8.3 8.4 15.6M16.3 10.9 10.6 16.2"/>
        </svg>
        Connections
        <span class="rounded-full bg-primary-100 px-2 py-0.5 text-xs tabular-nums text-primary-600 dark:bg-primary-800 dark:text-primary-300">
          {connectedNotes.length}<span class="sr-only"> linked {connectedNotes.length === 1 ? 'note' : 'notes'}</span>
        </span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-500 transition-transform duration-200 group-open/conn:rotate-180 dark:text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </summary>

    <ul class="border-t border-primary-200 p-1.5 dark:border-primary-800">
      {connectedNotes.map((note) => (
        <li>
          <a
            href={`/posts/${note.id}/`}
            class="block rounded-lg px-2 py-1.5 text-sm leading-snug text-primary-700 transition-colors hover:bg-primary-100 hover:text-accent-700 dark:text-primary-300 dark:hover:bg-primary-800 dark:hover:text-accent-300"
          >
            {note.title}
          </a>
        </li>
      ))}
    </ul>

    <div
      id="local-graph-content"
      class="w-full border-t border-primary-200 text-primary-600 dark:border-primary-800 dark:text-primary-400"
      style="height: 220px;"
      role="img"
      aria-label={`Graph of this note and its ${connectedNotes.length} linked ${connectedNotes.length === 1 ? 'note' : 'notes'}`}
    ></div>
  </details>
)}

<style>
  /* Smooth open and close where the browser can animate to height:auto.
     Elsewhere the panel simply opens. */
  @media (prefers-reduced-motion: no-preference) {
    .connections {
      interpolate-size: allow-keywords;
    }

    .connections::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 0.22s ease, content-visibility 0.22s allow-discrete;
    }

    .connections[open]::details-content {
      block-size: auto;
    }
  }
</style>

<script>
  import type * as D3 from 'd3';

  interface GraphNode extends D3.SimulationNodeDatum {
    id: string;
    title: string;
    connections: number;
  }

  interface GraphConnection {
    source: string | GraphNode;
    target: string | GraphNode;
  }

  interface GraphData {
    nodes: GraphNode[];
    connections: GraphConnection[];
    currentSlug?: string;
  }

  const STORAGE_KEY = 'connections-open';
  const LABEL_MAX = 14;

  function readOpen(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) === '1';
    } catch {
      return false;
    }
  }

  function writeOpen(open: boolean) {
    try {
      localStorage.setItem(STORAGE_KEY, open ? '1' : '0');
    } catch {
      // Private mode or blocked storage: the panel still works, it just forgets.
    }
  }

  // d3 is only fetched the first time a reader opens the panel.
  async function drawGraph(container: HTMLElement, content: HTMLElement) {
    const dataAttr = container.dataset.graph;
    if (!dataAttr) return;

    const data: GraphData = JSON.parse(dataAttr);
    if (data.nodes.length === 0) return;

    const d3 = await import('d3');

    content.innerHTML = '';

    const width = content.clientWidth;
    const height = content.clientHeight;

    const svg = d3
      .select(content)
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', [-width / 2, -height / 2, width, height]);

    const links = data.connections.map((d) => ({ ...d }));
    const nodes = data.nodes.map((d) => ({ ...d }));

    const simulation = d3
      .forceSimulation(nodes)
      .force(
        'link',
        d3
          .forceLink(links)
          .id((d: any) => d.id)
          .distance(78)
      )
      .force('charge', d3.forceManyBody().strength(-180))
      .force('center', d3.forceCenter(0, -6))
      .force('collision', d3.forceCollide().radius(34));

    const link = svg
      .append('g')
      .selectAll('line')
      .data(links)
      .join('line')
      .attr('stroke', 'currentColor')
      .attr('stroke-opacity', 0.35)
      .attr('stroke-width', 1);

    const node = svg
      .append('g')
      .selectAll('g')
      .data(nodes)
      .join('g')
      .attr('cursor', (d) => (d.id === data.currentSlug ? 'grab' : 'pointer'))
      .call(
        d3
          .drag<SVGGElement, GraphNode>()
          .on('start', (event, d) => {
            if (!event.active) simulation.alphaTarget(0.3).restart();
            d.fx = d.x;
            d.fy = d.y;
          })
          .on('drag', (event, d) => {
            d.fx = event.x;
            d.fy = event.y;
          })
          .on('end', (event, d) => {
            if (!event.active) simulation.alphaTarget(0);
            d.fx = null;
            d.fy = null;
          }) as any
      );

    // Full title on hover; the visible label is shortened so labels do not collide.
    node.append('title').text((d) => d.title);

    node
      .append('circle')
      .attr('r', (d) => (d.id === data.currentSlug ? 8 : 5 + Math.min(d.connections, 4)))
      .style('fill', (d) =>
        d.id === data.currentSlug ? 'rgb(var(--color-accent-500))' : 'rgb(var(--color-primary-400))'
      )
      .style('stroke', 'rgb(var(--color-primary-50))')
      .attr('stroke-width', 1.5);

    node
      .append('text')
      .text((d) => {
        if (d.id === data.currentSlug) return 'This note';
        const chars = Array.from(d.title);
        return chars.length > LABEL_MAX ? chars.slice(0, LABEL_MAX).join('') + '…' : d.title;
      })
      .attr('x', 0)
      // The current note's label sits above its node, clear of its neighbours' labels below theirs.
      .attr('y', (d) => (d.id === data.currentSlug ? -14 : 20))
      .attr('text-anchor', 'middle')
      .attr('fill', 'currentColor')
      .attr('font-size', '10px')
      .attr('font-weight', (d) => (d.id === data.currentSlug ? 600 : 400));

    node.on('click', (_event, d) => {
      if (d.id !== data.currentSlug) {
        window.location.href = `/posts/${d.id}/`;
      }
    });

    node
      .on('mouseover', function () {
        d3.select(this).select('circle').attr('stroke-width', 2.5);
      })
      .on('mouseout', function () {
        d3.select(this).select('circle').attr('stroke-width', 1.5);
      });

    // Keep nodes and their labels inside the panel.
    const padX = 44;
    const padY = 18;
    simulation.on('tick', () => {
      nodes.forEach((d: any) => {
        d.x = Math.max(-width / 2 + padX, Math.min(width / 2 - padX, d.x));
        d.y = Math.max(-height / 2 + padY + 12, Math.min(height / 2 - padY - 14, d.y));
      });

      link
        .attr('x1', (d: any) => d.source.x)
        .attr('y1', (d: any) => d.source.y)
        .attr('x2', (d: any) => d.target.x)
        .attr('y2', (d: any) => d.target.y);

      node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
    });
  }

  function initLocalGraph() {
    const container = document.getElementById('local-graph-container') as HTMLDetailsElement | null;
    const content = document.getElementById('local-graph-content');
    if (!container || !content) return;
    // Both load events call this.
    if (container.dataset.bound) return;
    container.dataset.bound = '1';

    let drawn = false;
    const drawOnce = () => {
      if (drawn || !container.open) return;
      drawn = true;
      drawGraph(container, content);
    };

    container.addEventListener('toggle', () => {
      writeOpen(container.open);
      drawOnce();
    });

    // A reader who left it open on the last note gets it open on this one.
    if (readOpen()) {
      container.open = true;
      drawOnce();
    }
  }

  document.addEventListener('DOMContentLoaded', initLocalGraph);
  document.addEventListener('astro:page-load', initLocalGraph);
</script>
