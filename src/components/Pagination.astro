---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center"
      aria-label="Pagination"
      data-infinite
      data-next={page.url.next}
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["me-4 select-none", { "opacity-50": !page.url.prev }]}
        ariaLabel="Previous"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        Prev
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["ms-4 select-none", { "opacity-50": !page.url.next }]}
        ariaLabel="Next"
      >
        Next
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}

<script>
  // "Load more": with JS, swap Prev/Next for a button that appends the next
  // page's cards in place. Without JS the page links still work.
  function setupLoadMore() {
    const nav = document.querySelector<HTMLElement>("nav[data-infinite]");
    const list = document.querySelector("#main-content ul");
    let next = nav?.dataset.next;
    if (!nav || !list || !next) return;

    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "Load more";
    button.className =
      "mx-auto mt-auto mb-8 block rounded border border-accent px-4 py-1 text-accent hover:bg-accent hover:text-background disabled:opacity-50";
    nav.hidden = true;
    nav.before(button);

    button.addEventListener("click", async () => {
      button.disabled = true;
      button.textContent = "Loading…";
      try {
        const html = await (await fetch(next!)).text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        list.append(...doc.querySelectorAll("#main-content ul > li"));
        next = doc.querySelector<HTMLElement>("nav[data-infinite]")?.dataset
          .next;
      } catch {
        nav.hidden = false; // fetch failed: fall back to the page links
        next = undefined;
      }
      if (next) {
        button.disabled = false;
        button.textContent = "Load more";
      } else {
        button.remove();
      }
    });
  }

  document.addEventListener("astro:page-load", setupLoadMore);
</script>
