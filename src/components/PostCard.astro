---
/**
 * One row for every note. An icon card is wider only because its grid
 * item spans two columns; this component just fills that cell.
 */

import type { Post, GrowthStatus } from '../types';
import GrowthIndicator from './GrowthIndicator.astro';
import MemoryPoint from './MemoryPoint.astro';
import Tags from './Tags.astro';
import { siteConfig } from '../config';
import { participatesInGrowth } from '../utils/growth';

export interface Props {
  post: Post;
  effectiveGrowth?: GrowthStatus; // Calculated growth (may differ from post.data.growth)
}

const { post, effectiveGrowth } = Astro.props;
const { title, description, growth, planted, tags, icon } = post.data;
// Use effective growth if provided, otherwise fall back to manual growth
const displayGrowth = effectiveGrowth || growth;
const showGrowth = siteConfig.garden.showGrowthStatus && participatesInGrowth(tags);

const plantedDate = planted.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: siteConfig.timezone,
});

const hasTags = Boolean(siteConfig.posts.showTags && tags && tags.length > 0);
---

<article class="card group flex h-full min-w-0 flex-1 flex-row overflow-hidden">
  <div class="flex min-w-0 grow flex-col p-6">
    <a href={`/posts/${post.id}/`} class="block min-w-0 grow">
      <div class="mb-3 flex items-center justify-between text-sm text-primary-500">
        {showGrowth && (
          <GrowthIndicator status={displayGrowth} size="sm" />
        )}
        <time class="ml-auto">
          {plantedDate}
        </time>
      </div>

      <h3 class="mb-2 text-xl leading-snug text-primary-900 dark:text-primary-100">
        {title}
      </h3>

      {description && (
        <p class="text-sm text-primary-600 dark:text-primary-400 line-clamp-2 mb-3">
          {description}
        </p>
      )}
    </a>

    {hasTags && (
      <div class="mt-auto min-w-0 w-full border-t border-primary-100 pt-3 dark:border-primary-800">
        <Tags tags={(tags ?? []).slice(0, 4)} />
      </div>
    )}
  </div>

  {icon && (
    <a
      href={`/posts/${post.id}/`}
      tabindex="-1"
      aria-hidden="true"
      class="flex w-[40%] shrink-0"
    >
      <MemoryPoint src={icon} alt="" variant="card" />
    </a>
  )}
</article>
