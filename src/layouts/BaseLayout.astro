---
/**
 * BaseLayout - Root layout for all pages
 *
 * Handles:
 * - HTML document structure
 * - SEO meta tags
 * - Dark mode initialization
 * - Color theme initialization before first paint
 * - Global styles
 * - Command palette
 */

import { siteConfig } from '../config';
import { defaultTheme, themes } from '../themes';
import { ogLocale } from '../utils/lang';
import CommandPalette from '../components/CommandPalette.astro';
import GlobalGraph from '../components/GlobalGraph.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  /** BCP 47 language of the page content. Defaults to the site language. */
  lang?: string;
  /** Article pages pass their dates and tags; everything else is a website page. */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  /** Path of a Markdown copy of this page, advertised to agents. */
  markdownPath?: string;
}

const {
  title,
  description = siteConfig.description,
  image,
  noIndex = false,
  lang = siteConfig.language,
  article,
  markdownPath,
} = Astro.props;

// The home page has no title of its own; say what the site is.
const pageTitle = title
  ? `${title} | ${siteConfig.name}`
  : `${siteConfig.name} | ${siteConfig.description.replace(/\.$/, '')}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const authorUrl = new URL('/about/', Astro.site);

// Who publishes this site. Article pages add their own BlogPosting on top.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: siteConfig.name,
      description: siteConfig.description,
      inLanguage: [...new Set([siteConfig.language, lang])],
      publisher: { '@id': new URL('/#person', Astro.site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', Astro.site).href,
      name: siteConfig.gardener,
      url: authorUrl.href,
      sameAs: siteConfig.navigation.social.map((link) => link.url),
    },
  ],
};
// Use post image if provided, otherwise fall back to default OG image
const ogImage = image
  ? new URL(image, Astro.site)
  : new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.gardener} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Plain-text copies for agents and LLM tools -->
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}

    <!-- RSS Feed -->
    {siteConfig.features.rss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={siteConfig.name}
        href="/feed.xml"
      />
    )}

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        <meta property="article:modified_time" content={(article.modifiedTime ?? article.publishedTime).toISOString()} />
        <meta property="article:author" content={authorUrl.href} />
        {(article.tags ?? []).map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter / X reads name=, not property= -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Site and author, for search and answer engines -->
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <!-- Dark mode initialization (prevent flash) -->
    <script is:inline>
      (function() {
        // Saved preference has to be on <html> before CSS, and again on the
        // incoming document because view transitions replace root attributes.
        function applyDark(root) {
          var theme;
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {
            theme = null;
          }
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) {
            root.classList.add('dark');
          } else {
            root.classList.remove('dark');
          }
        }

        applyDark(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          var next = event.newDocument && event.newDocument.documentElement;
          if (next) applyDark(next);
        });
      })();
    </script>

    <!-- Color theme initialization. Runs before the stylesheet so the saved
         palette, not the build-time default, is what first paint uses. -->
    <script is:inline define:vars={{ themes, defaultTheme }}>
      (function () {
        function applyColorTheme(themeName, root) {
          var el = root || document.documentElement;
          var name = themeName;
          var stored = null;
          if (!name) {
            try {
              stored = localStorage.getItem('colorTheme');
            } catch (e) {
              stored = null;
            }
            name = stored;
          }
          // A removed palette has no CSS variables. Fall back before paint and
          // replace the saved name so the picker and the next load agree.
          if (!themes[name]) {
            name = defaultTheme;
            try {
              if (stored && !themes[stored]) localStorage.setItem('colorTheme', defaultTheme);
            } catch (e) {}
          }
          var theme = themes[name];
          if (!theme || !el) return;

          Object.entries(theme.colors.primary).forEach(function (entry) {
            el.style.setProperty('--color-primary-' + entry[0], entry[1]);
          });
          // Inline values beat the stylesheet, so anything that differs between
          // light and dark has to be chosen here, per mode.
          var dark = el.classList.contains('dark');
          var accent = (dark && theme.colors.accentDark) || theme.colors.accent;
          Object.entries(accent).forEach(function (entry) {
            el.style.setProperty('--color-accent-' + entry[0], entry[1]);
          });
          var ground = dark ? theme.colors.bg.dark : theme.colors.bg.light;
          el.style.setProperty('--bg-primary', ground);
          el.style.setProperty('--bg-secondary', ground);
        }

        applyColorTheme.themes = themes;
        applyColorTheme.defaultName = defaultTheme;
        window.applyColorTheme = applyColorTheme;
        applyColorTheme();

        window.addEventListener('themechange', function () {
          applyColorTheme();
        });

        document.addEventListener('astro:before-swap', function (event) {
          var next = event.newDocument && event.newDocument.documentElement;
          if (next) applyColorTheme(null, next);
        });
      })();
    </script>

    <!-- Slot for page-specific head content (JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />

    <main class="grow">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Command Palette -->
    <CommandPalette />

    <!-- Global Graph -->
    {siteConfig.features.graphView && <GlobalGraph />}

    <!-- Theme toggle script -->
    <script>
      // Theme toggle functionality
      function initThemeToggle() {
        const toggleButtons = document.querySelectorAll('[data-theme-toggle]');

        toggleButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            // Dispatch event for components that need to react to theme changes
            window.dispatchEvent(new CustomEvent('themechange', { detail: { dark: isDark } }));
          });
        });
      }

      // Initialize on load and after page transitions
      document.addEventListener('DOMContentLoaded', initThemeToggle);
      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
  </body>
</html>
