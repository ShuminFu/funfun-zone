---
/**
 * BaseLayout - Root layout for all pages
 *
 * Handles:
 * - HTML document structure
 * - SEO meta tags
 * - Dark mode initialization
 * - Color theme initialization before first paint
 * - Global styles
 * - Command palette
 */

import { siteConfig } from '../config';
import { defaultTheme, themes } from '../themes';
import CommandPalette from '../components/CommandPalette.astro';
import GlobalGraph from '../components/GlobalGraph.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  noIndex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Use post image if provided, otherwise fall back to default OG image
const ogImage = image
  ? new URL(image, Astro.site)
  : new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- RSS Feed -->
    {siteConfig.features.rss && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={siteConfig.name}
        href="/feed.xml"
      />
    )}

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Dark mode initialization (prevent flash) -->
    <script is:inline>
      (function() {
        // Saved preference has to be on <html> before CSS, and again on the
        // incoming document because view transitions replace root attributes.
        function applyDark(root) {
          var theme;
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {
            theme = null;
          }
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && prefersDark)) {
            root.classList.add('dark');
          } else {
            root.classList.remove('dark');
          }
        }

        applyDark(document.documentElement);
        document.addEventListener('astro:before-swap', function (event) {
          var next = event.newDocument && event.newDocument.documentElement;
          if (next) applyDark(next);
        });
      })();
    </script>

    <!-- Color theme initialization. Runs before the stylesheet so the saved
         palette, not the build-time default, is what first paint uses. -->
    <script is:inline define:vars={{ themes, defaultTheme }}>
      (function () {
        function applyColorTheme(themeName, root) {
          var el = root || document.documentElement;
          var name = themeName;
          var stored = null;
          if (!name) {
            try {
              stored = localStorage.getItem('colorTheme');
            } catch (e) {
              stored = null;
            }
            name = stored;
          }
          // A removed palette has no CSS variables. Fall back before paint and
          // replace the saved name so the picker and the next load agree.
          if (!themes[name]) {
            name = defaultTheme;
            try {
              if (stored && !themes[stored]) localStorage.setItem('colorTheme', defaultTheme);
            } catch (e) {}
          }
          var theme = themes[name];
          if (!theme || !el) return;

          Object.entries(theme.colors.primary).forEach(function (entry) {
            el.style.setProperty('--color-primary-' + entry[0], entry[1]);
          });
          Object.entries(theme.colors.accent).forEach(function (entry) {
            el.style.setProperty('--color-accent-' + entry[0], entry[1]);
          });
          el.style.setProperty('--bg-primary', theme.colors.bg.light);
          el.style.setProperty('--bg-secondary', theme.colors.bg.light);
        }

        applyColorTheme.themes = themes;
        applyColorTheme.defaultName = defaultTheme;
        window.applyColorTheme = applyColorTheme;
        applyColorTheme();

        document.addEventListener('astro:before-swap', function (event) {
          var next = event.newDocument && event.newDocument.documentElement;
          if (next) applyColorTheme(null, next);
        });
      })();
    </script>

    <!-- Slot for page-specific head content (JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />

    <main class="grow">
      <slot />
    </main>

    <slot name="footer" />

    <!-- Command Palette -->
    <CommandPalette />

    <!-- Global Graph -->
    {siteConfig.features.graphView && <GlobalGraph />}

    <!-- Theme toggle script -->
    <script>
      // Theme toggle functionality
      function initThemeToggle() {
        const toggleButtons = document.querySelectorAll('[data-theme-toggle]');

        toggleButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            // Dispatch event for components that need to react to theme changes
            window.dispatchEvent(new CustomEvent('themechange', { detail: { dark: isDark } }));
          });
        });
      }

      // Initialize on load and after page transitions
      document.addEventListener('DOMContentLoaded', initThemeToggle);
      document.addEventListener('astro:page-load', initThemeToggle);
    </script>
  </body>
</html>
